{
    "manifest_version": 3,
    "name": "Ai Powered BookMark Saver",
    "version": "1.0",
    "permissions": ["bookmarks", "storage", "activeTab"],
    "host_permissions": ["http://localhost:3002/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    }
}
    